APP_ENV=paper
LIVE_TRADING=false
EXCHANGE=binance
SYMBOLS=BTC/USDT,ETH/USDT
TIMEFRAME=1h
CANDLE_LIMIT=500
STARTING_BALANCE=1000
TRADING_FEE=0.001
SLIPPAGE=0.0005
MAX_POSITION_SIZE=0.10
MAX_OPEN_POSITIONS=3
MAX_DAILY_LOSS=0.03
MAX_DRAWDOWN=0.15
MIN_AI_CONFIDENCE=0.60
DATA_SOURCE=synthetic
DB_PATH=
EXPERIMENT_ID=

# Legacy single-provider config (used if AI_PARTICIPANTS is empty)
AI_PROVIDER=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Tournament: comma-separated provider names
# Available: openai, deepseek, gemini, openrouter, groq, anthropic, test
AI_PARTICIPANTS=test

# Provider API keys (only set the ones you want to use)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3-haiku

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307

# ─── AI Resilience Configuration ──────────────────────────────────────────────
# Failover: enabled for paper-trading, disabled by default in tournament for fairness
AI_FAILOVER_ENABLED=false

# Fallback provider (used when primary fails and failover is enabled)
AI_FALLBACK_PROVIDER=
AI_FALLBACK_MODEL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_BASE_URL=

# AI Response Cache (deduplication for repeated prompts on same candle)
AI_CACHE_ENABLED=true
AI_CACHE_MAX_SIZE=1000
AI_CACHE_TTL_SECONDS=3600

# Cooldown & Backoff (circuit breaker pattern)
AI_COOLDOWN_SECONDS=60
AI_MAX_FAILURES_BEFORE_COOLDOWN=3
AI_MAX_COOLDOWN_SECONDS=3600

# Daily Quota Limits (0 = unlimited)
AI_DAILY_TOKEN_LIMIT=0
AI_DAILY_REQUEST_LIMIT=0

# Rate Limiting (requests per minute / tokens per minute)
AI_GLOBAL_MAX_RPM=0
AI_GLOBAL_MAX_TPM=0
AI_PER_PROVIDER_MAX_RPM=0
AI_PER_PROVIDER_MAX_TPM=0

# ─── Milestone 5: Paper-Live Configuration ────────────────────────────────────
# Paper session ID (auto-generated if empty)
PAPER_SESSION_ID=
# Auto-resume existing sessions on restart
PAPER_AUTO_RESUME=true
# Maximum staleness before refusing to trade (seconds)
MARKET_MAX_STALE_SECONDS=300
# Retry interval when market data fails (seconds)
MARKET_RETRY_SECONDS=30
# Heartbeat logging interval (seconds)
PAPER_HEARTBEAT_SECONDS=300

# ─── Milestone 6: MT5 Demo Configuration ──────────────────────────────────────
# Enable MT5 adapter (requires MetaTrader5 package on Windows/VPS)
MT5_ENABLED=false
# DEMO ONLY: refuse non-demo accounts (DO NOT set to false)
MT5_DEMO_ONLY=true
# Enable order execution on demo account (double safety gate)
MT5_DEMO_TRADING_ENABLED=false

# MT5 terminal connection
MT5_PATH=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TIMEOUT=10000

# Expected account verification (fail if mismatch)
MT5_EXPECTED_SERVER=
MT5_EXPECTED_LOGIN=

# Magic number for AshtradingAI orders (isolates from other EAs)
MT5_MAGIC_NUMBER=20260904

# Symbol mapping JSON: {"BTC/USDT": "BTCUSD.", "ETH/USDT": "ETHUSD."}
MT5_SYMBOL_MAP=
